# Example environment variables for the API server
# Copy this file to .env and fill in your secrets before running the API.

DATABASE_URL=postgresql://user:password@localhost:5432/blogdb?schema=public
PORT=3000
FRONTEND_URL=your_site_here
JWT_SECRET=your_jwt_secret_here
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Seed credentials for local development
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_secure_admin_password
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=your_secure_user_password
